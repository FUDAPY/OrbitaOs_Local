# OrbitaOs - variables de entorno
#   cp .env.example .env    (una sola vez, despues editar los valores)
# Este archivo NUNCA se versiona (esta en .gitignore).

# --- Entorno ----------------------------------------------------------------
NODE_ENV=development
TZ=America/Asuncion
# Zona horaria usada para interpretar fechas sin zona explicita.
# Cada usuario puede tener la suya (campo "timezone" del modelo User).

# --- MongoDB ----------------------------------------------------------------
# Local con Node: mongodb://localhost:27017/orbitaos (Mongo en el puerto 27017).
# En Docker Compose el servicio fija mongodb://mongo:27017/orbitaos.
MONGO_URI=mongodb://localhost:27017/orbitaos
MONGO_MAX_POOL_SIZE=10

# --- Space Bunny Alpha (IA) -------------------------------------------------
# Endpoint oficial compatible con OpenAI (mismo esquema que OpenRouter).
# La clave es del formato sb_live_... y se obtiene en la pagina de la API.
#
# Si la API KEY queda vacia, OrbitaOs arranca en MODO MOCK: el enrutador
# usa reglas locales para detectar la intencion y el sistema sigue operativo.
SPACE_BUNNY_API_URL=https://spacebunnymodel.com/api/v1/chat/completions
SPACE_BUNNY_API_KEY=
SPACE_BUNNY_MODEL=space-bunny-alpha
SPACE_BUNNY_TEMPERATURE=0.2
# Space Bunny Alpha es un modelo de razonamiento: gasta tokens pensando antes
# de responder. Un max_tokens bajo lo corta a mitad del razonamiento.
SPACE_BUNNY_MAX_TOKENS=4096
SPACE_BUNNY_TIMEOUT_MS=60000
# Ultimos mensajes de la conversacion que se envían como contexto.
AI_CONTEXT_MESSAGES=8
# Tope diario de llamadas a la IA. Al alcanzarlo el bot responde con las
# reglas locales (modo mock) en vez de llamar a Space Bunny.
# 0 = sin limite. Ej: 200 para un uso moderado.
SPACE_BUNNY_DAILY_CAP=0

# --- Seguridad / usuarios -------------------------------------------------
# Primer usuario del sistema: se crea automaticamente en el primer arranque
# si la base de datos esta vacia. Es el unico que puede administer usuarios.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=
# Telefono del administrador: recibe advertencias del sistema.
ADMIN_PHONE=54911123456789
# Numeros autorizados a administrar la lista blanca desde WhatsApp.
# Coma separados. Quien figure aqui puede usar /agregar, /quitar y /contactos.
ADMIN_WHITELIST=

# Telefonos autorizados, separados por coma, formato internacional sin + ni
# espacios: 54911123456789,54911987654321
#
# Opcional: si queda vacio el servicio arranca igual. Los telefonos listados
# aqui se dan de alta como usuarios con acceso al bot. Para gestionarlos despues
# usar:  npm run user -- create <usuario> <clave> --phone <numero>
WHITELIST=

# --- Sesion de WhatsApp ----------------------------------------------------
# NUMERO del WhatsApp corporativo, con prefijo del pais y sin simbolos.
# Ejemplo Argentina: 54911123456789   |   Mexico: 5215512345678
#
# Es lo MAS IMPORTANTE para arrancar: si esta definido, el bot se empareja con
# un CODIGO de 8 caracteres (ideal en un servidor sin monitor). Si queda vacio,
# hay que escanear el QR que aparece en los logs.
BOT_PHONE=

# Carpeta de sesion (LocalAuth). En local ./session; en Docker la fija el compose.
SESSION_PATH=./session
# Ruta del perfil de Puppeteer/Chromium.
PUPPETEER_USER_DATA_DIR=./.wwebjs
# Separar el perfil del bot del directorio de sesion.
WEBJS_CACHE_TYPE=local

# --- Recordatorios (cron) ---------------------------------------------------
# Expresion cron del motor de recordatorios (minuto hora dia mes diaSemana).
# Por defecto cada minuto: es la base para las ventanas de 24h y 2h.
CRON_REMINDERS=*/1 * * * *
CRON_TZ=America/Asuncion
# Ventana de tolerancia, en minutos, por lado del hito (24h / 2h).
# Evita perder un recordatorio si el contenedor se reinicia justo en ese minuto.
REMINDER_TOLERANCE_MINUTES=10
# Zona horaria usada para los textos de los recordatorios.
REMINDER_TIMEZONE=America/Asuncion

# --- Comportamiento ---------------------------------------------------------
# Prefijo para que el bot responda en los grupos. Vacio = solo privado.
GROUP_PREFIX=
# Log del contenido de los mensajes (util para depurar). true/false
LOG_MESSAGES=true

# --- Servidor HTTP (salud + panel) ------------------------------------------
# Responde /health, / (panel web) y /api/* (JSON).
# Local: http://localhost:3000
PORT=3000

# --- Busqueda web (DuckDuckGo, sin costo) ----------------------------------
# Permite que la IA consulte internet con la herramienta buscar_en_web.
# Poner en false la desactiva por completo.
WEB_SEARCH_ENABLED=true
